APP_NAME=Foodsy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# file / sync: the project has no sessions, cache or jobs tables
# (Laravel 11+ would default to "database" and the login would fail)
BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=public

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Symfony Mailer needs a real sender address
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@foodsy.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# payment gateway: "fake" works offline (test cards in README), "braintree" needs a sandbox account
PAYMENT_DRIVER=fake
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=

# size of the generated demo catalog: full (default) or test (config/seeding.php)
SEED_PROFILE=full

# demo accounts of the portfolio, shown on the login page (config/demo.php).
# On by default outside production; the passwords below are development values only.
DEMO_ACCOUNTS=true
DEMO_ADMIN_EMAIL=admin@foodsy.test
DEMO_ADMIN_PASSWORD=foodsy-admin
DEMO_RESTAURATEUR_EMAIL=restaurant_owner@foodsy.test
DEMO_RESTAURATEUR_PASSWORD=12345678
DEMO_CUSTOMER_EMAIL=customer@foodsy.test
DEMO_CUSTOMER_PASSWORD=foodsy-demo

# platform backoffice (config/platform.php): simulated commission on completed orders (0.25 = 25%)
PLATFORM_COMMISSION_RATE=0.25
