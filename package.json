{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "build": "npm run prod",
        "development": "cross-env NODE_ENV=development NODE_OPTIONS=--openssl-legacy-provider node_modules/webpack/bin/webpack.js --progress --config=node_modules/laravel-mix/setup/webpack.config.js",
        "watch": "npm run development -- --watch",
        "watch-poll": "npm run watch -- --watch-poll",
        "hot": "cross-env NODE_ENV=development NODE_OPTIONS=--openssl-legacy-provider node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --disable-host-check --config=node_modules/laravel-mix/setup/webpack.config.js",
        "prod": "npm run production",
        "production": "cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider node_modules/webpack/bin/webpack.js --no-progress --config=node_modules/laravel-mix/setup/webpack.config.js",
        "test:js": "vitest run"
    },
    "devDependencies": {
        "@vitejs/plugin-vue2": "^2.3.4",
        "@vue/test-utils": "^1.3.6",
        "axios": "^0.21.1",
        "bootstrap": "^4.6.0",
        "cross-env": "^7.0",
        "jquery": "^3.2",
        "jsdom": "^26.1.0",
        "laravel-mix": "^5.0.1",
        "lodash": "^4.17.19",
        "popper.js": "^1.12",
        "resolve-url-loader": "^2.3.1",
        "sass": "^1.37.0",
        "sass-loader": "^8.0.0",
        "vite": "^7.3.8",
        "vitest": "^3.2.7",
        "vue": "^2.7.16",
        "vue-template-compiler": "^2.7.16"
    },
    "dependencies": {
        "bootstrap-vue": "^2.21.2",
        "braintree-web": "^3.79.1",
        "chart.js": "^3.5.0",
        "jw-vue-pagination": "^1.0.3",
        "vue-router": "^3.5.2",
        "vuex": "^3.6.2",
        "vuex-persistedstate": "^4.0.0"
    }
}
